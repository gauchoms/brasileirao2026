# ========================================
# BANCO DE DADOS - PRODUÇÃO
# ========================================

# PostgreSQL de Produção (ex: Render, Heroku, Railway)
PROD_DATABASE_URL=postgresql://user:password@host:5432/database

# Exemplo Render:
# PROD_DATABASE_URL=postgresql://user_abc:xyz123@dpg-abc123.oregon-postgres.render.com/database_abc

# ========================================
# BANCO DE DADOS - LOCAL
# ========================================

# Para PostgreSQL local:
LOCAL_DATABASE_URL=postgresql://localhost:5432/brasileirao_dev

# Para SQLite (padrão):
# LOCAL_DATABASE_URL=sqlite:///instance/app.db

# ========================================
# SINCRONIZAÇÃO
# ========================================

# Tabelas a sincronizar (separadas por vírgula)
SYNC_TABLES=competicao,time,jogo,projecao,meta,usuario

# Auto-sincronizar ao iniciar app? (true/false)
AUTO_SYNC_ON_START=false

# Intervalo de sincronização automática (em horas)
AUTO_SYNC_INTERVAL=24
